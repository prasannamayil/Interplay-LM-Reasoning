# GSM early-checkpoint ramp: one arch per job (m-size, frequent early ckpts). 1 GPU, resumable.
# Submit: condor_submit_bid 100 -a 'ARCH=dense' scripts/widen_line/condor/exp_gsm_ramp.sub
request_cpus   = 8
request_gpus   = 1
request_memory = 64G
request_disk   = 40G
requirements   = (CUDADeviceName == "NVIDIA A100-SXM4-80GB")

environment = "ARCH=$(ARCH)"

log_root = /fast/pmayilvahanan/condor_logs/widen/ramp_$(ARCH)_$(ClusterId)
error    = $(log_root).err
output   = $(log_root).out
log      = $(log_root).log

MaxTime = 28800
periodic_remove = (JobStatus =?= 2) && ((CurrentTime - JobCurrentStartDate) >= $(MaxTime))
periodic_release = (JobStatus =?= 5) && (HoldReasonCode =?= 34) && (NumJobStarts < 10)

executable = /lustre/fast/fast/pmayilvahanan/Interplay-LM-Reasoning/scripts/widen_line/exp_run_ramp.sh
getenv = True

queue 1
