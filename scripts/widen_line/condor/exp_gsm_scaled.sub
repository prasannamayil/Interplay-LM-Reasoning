# GSM size-sweep: one (arch, size) per job. 1 GPU, resumable (fixed dump dir).
# Submit: condor_submit_bid 100 -a 'ARCH=dense' -a 'SIZE=l' scripts/widen_line/condor/exp_gsm_scaled.sub
request_cpus   = 8
request_gpus   = 1
request_memory = 96G
request_disk   = 40G
requirements   = (CUDADeviceName == "NVIDIA A100-SXM4-80GB")

environment = "ARCH=$(ARCH) SIZE=$(SIZE)"

log_root = /fast/pmayilvahanan/condor_logs/widen/scaled_$(ARCH)_$(SIZE)_$(ClusterId)
error    = $(log_root).err
output   = $(log_root).out
log      = $(log_root).log

MaxTime = 57600
periodic_remove = (JobStatus =?= 2) && ((CurrentTime - JobCurrentStartDate) >= $(MaxTime))
periodic_release = (JobStatus =?= 5) && (HoldReasonCode =?= 34) && (NumJobStarts < 10)

executable = /lustre/fast/fast/pmayilvahanan/Interplay-LM-Reasoning/scripts/widen_line/exp_run_scaled.sh
getenv = True

queue 1
