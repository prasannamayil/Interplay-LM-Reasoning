# Experiment B: proposal-scale FineWeb-Edu widen-line, one 8-GPU full-node job per arch.
# Submit:  condor_submit_bid 100 scripts/widen_line/condor/fineweb_b.sub
# Fixed dump dirs => resubmitting a preempted arch RESUMES from checkpoint.
request_cpus   = 64
request_gpus   = 8
request_memory = 512G
request_disk   = 200G
requirements   = (CUDADeviceName == "NVIDIA A100-SXM4-80GB")

environment = "ARCH=$(ARCH)"

log_root = /fast/pmayilvahanan/condor_logs/widen/fineweb_b_$(ARCH)_$(ClusterId)
error    = $(log_root).err
output   = $(log_root).out
log      = $(log_root).log

MaxTime = 172800
periodic_remove = (JobStatus =?= 2) && ((CurrentTime - JobCurrentStartDate) >= $(MaxTime))

executable = /lustre/fast/fast/pmayilvahanan/Interplay-LM-Reasoning/scripts/widen_line/fineweb_run.sh
getenv = True

queue 1
