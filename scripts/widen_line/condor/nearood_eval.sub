# Near-OOD re-eval (ops 11-14) of hard-GSM checkpoints. 1 GPU, eval-only.
request_cpus   = 8
request_gpus   = 1
request_memory = 64G
request_disk   = 20G
requirements   = (CUDADeviceName == "NVIDIA A100-SXM4-80GB")
log_root = /fast/pmayilvahanan/condor_logs/widen/nearood_$(ClusterId)
error    = $(log_root).err
output   = $(log_root).out
log      = $(log_root).log
MaxTime = 28800
periodic_remove = (JobStatus =?= 2) && ((CurrentTime - JobCurrentStartDate) >= $(MaxTime))
periodic_release = (JobStatus =?= 5) && (HoldReasonCode =?= 34) && (NumJobStarts < 10)
executable = /lustre/fast/fast/pmayilvahanan/Interplay-LM-Reasoning/scripts/widen_line/nearood_eval.sh
getenv = True
queue 1
