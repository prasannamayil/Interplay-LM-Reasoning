# GSM HARD-skewed size sweep: one (arch,size) per job, trained on the op8-10-oversampled
# source. STEPS=12000 (hard ops need more tokens), eval 4k/8k/12k -> size AND checkpoint
# spread. Submit: condor_submit_bid 100 -a 'ARCH=dense' -a 'SIZE=l' scripts/widen_line/condor/exp_gsm_hard.sub
request_cpus   = 8
request_gpus   = 1
request_memory = 96G
request_disk   = 40G
requirements   = (CUDADeviceName == "NVIDIA A100-SXM4-80GB")

SEED =
environment = "ARCH=$(ARCH) SIZE=$(SIZE) SEED=$(SEED) DATA_ROOT=/lustre/fast/fast/pmayilvahanan/Interplay-LM-Reasoning/data/composition_lingua_hard EXP_ROOT=/lustre/fast/fast/pmayilvahanan/Interplay-LM-Reasoning/results/widen_line/exp_gsm_hard STEPS=12000 EVAL_CKPTS='4000 8000 12000'"

log_root = /fast/pmayilvahanan/condor_logs/widen/hard_$(ARCH)_$(SIZE)_$(ClusterId)
error    = $(log_root).err
output   = $(log_root).out
log      = $(log_root).log

MaxTime = 57600
periodic_remove = (JobStatus =?= 2) && ((CurrentTime - JobCurrentStartDate) >= $(MaxTime))
periodic_release = (JobStatus =?= 5) && (HoldReasonCode =?= 34) && (NumJobStarts < 10)

executable = /lustre/fast/fast/pmayilvahanan/Interplay-LM-Reasoning/scripts/widen_line/exp_run_scaled.sh
getenv = True

queue 1
