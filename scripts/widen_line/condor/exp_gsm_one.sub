# Single-arch (re)submit for the widen GSM experiment. Used to resume a preempted
# arch (fixed dump dir => resumes from checkpoint).
# Submit:  condor_submit_bid 100 -a 'ARCH=moe' scripts/widen_line/condor/exp_gsm_one.sub
request_cpus   = 8
request_gpus   = 1
request_memory = 64G
request_disk   = 30G
requirements   = (CUDADeviceName == "NVIDIA A100-SXM4-80GB")

environment = "ARCH=$(ARCH)"

log_root = /fast/pmayilvahanan/condor_logs/widen/exp_$(ARCH)_$(ClusterId)
error    = $(log_root).err
output   = $(log_root).out
log      = $(log_root).log

MaxTime = 28800
periodic_remove = (JobStatus =?= 2) && ((CurrentTime - JobCurrentStartDate) >= $(MaxTime))
periodic_release = (JobStatus =?= 5) && (HoldReasonCode =?= 34) && (NumJobStarts < 10)

executable = /lustre/fast/fast/pmayilvahanan/Interplay-LM-Reasoning/scripts/widen_line/exp_run.sh
getenv = True

queue 1
