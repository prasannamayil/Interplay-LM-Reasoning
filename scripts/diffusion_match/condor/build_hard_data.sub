# CPU job: build the HARD-skewed tokenized diffusion data (seq1024), matched to
# the widen AR line. No GPU. Submit:  condor_submit_bid 40 scripts/diffusion_match/condor/build_hard_data.sub
request_cpus   = 64
request_memory = 256G
request_disk   = 300G

log_root = /fast/pmayilvahanan/condor_logs/diffusion_match/build_hard_data_$(ClusterId)
error    = $(log_root).err
output   = $(log_root).out
log      = $(log_root).log

MaxTime = 43200
periodic_remove = (JobStatus =?= 2) && ((CurrentTime - JobCurrentStartDate) >= $(MaxTime))
periodic_release = (JobStatus =?= 5) && (HoldReasonCode =?= 34) && (NumJobStarts < 10)

executable = /lustre/fast/fast/pmayilvahanan/Interplay-LM-Reasoning/scripts/diffusion_match/build_hard_data.sh
getenv = True

queue 1
